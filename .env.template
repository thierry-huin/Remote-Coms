# Winus Video Server — Environment Configuration
# Copy to .env and adjust for your deployment.

# Public IPs (comma-separated) that clients use to reach this server.
# Must match DNS or be reachable from viewers.
MEDIASOUP_ANNOUNCED_IPS=YOUR_PUBLIC_IP
EXTERNAL_IP=YOUR_PUBLIC_IP
LOCAL_IP=YOUR_LOCAL_IP

# Ports
HTTPS_PORT=9443
HTTP_PORT=9080
BACKEND_PORT=3100
RTP_MIN_PORT=10201
RTP_MAX_PORT=10400

# TURN/STUN -- standalone coturn service in this docker-compose (see the
# "coturn" service), independent of Winus Intercom. Leave TURN_HOST empty
# to use EXTERNAL_IP above. Also open the relay port range 49201-49250/udp
# (see coturn/turnserver.conf) in addition to TURN_PORT.
TURN_HOST=
TURN_PORT=3480
TURN_USER=intercom
TURN_PASSWORD=intercom2024

# Auth
JWT_SECRET=CHANGE_ME_random_string_here

ADMIN_USER=admin
ADMIN_PASS=admin
